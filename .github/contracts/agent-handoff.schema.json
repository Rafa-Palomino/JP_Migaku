{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent-handoff.schema.json",
  "title": "Agent Handoff Block",
  "description": "Structured context block passed from an invoking agent to a specialist agent. Embed as a YAML code block in the invocation prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "from_agent",
    "to_agent",
    "deliverable",
    "scope",
    "stability_gate",
    "prior_decisions",
    "validation_done",
    "context_completeness"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 4,
      "description": "Identifier that links this handoff to the parent operation log entry."
    },
    "from_agent": {
      "type": "string",
      "description": "Name of the delegating agent."
    },
    "to_agent": {
      "type": "string",
      "description": "Name of the specialist agent being invoked."
    },
    "deliverable": {
      "type": "string",
      "minLength": 10,
      "description": "Concrete output expected from the specialist: e.g. 'code change with syntax validation', 'ADR for X decision', 'defect list in severity order'."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Affected file paths relative to repo root."
        },
        "modules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Logical modules or subsystems in play (e.g. 'GPU pipeline', 'auth layer')."
        },
        "description": {
          "type": "string",
          "description": "Optional free-text scope clarification."
        }
      }
    },
    "stability_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_stable"],
      "properties": {
        "confirmed_stable": {
          "type": "boolean",
          "description": "True if the user has confirmed the system is in a stable state."
        },
        "branch": {
          "type": ["string", "null"],
          "description": "Feature branch already created (agent/<task-slug>-YYYY-MM-DD), or null if not yet created."
        }
      }
    },
    "prior_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reverts", "validated"],
      "properties": {
        "reverts": {
          "type": "array",
          "description": "Mechanisms or patterns that were previously reverted or documented as failures. Each is a hard blocker.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "reason", "hard_blocker"],
            "properties": {
              "mechanism": { "type": "string" },
              "date": { "type": "string", "description": "YYYY-MM-DD or approximate." },
              "reason": { "type": "string" },
              "source": { "type": "string", "description": "Where this was found: git commit, ADR file, operation log run_id." },
              "hard_blocker": {
                "type": "boolean",
                "description": "If true, the specialist must escalate to the user instead of reinterpreting."
              }
            }
          }
        },
        "validated": {
          "type": "array",
          "description": "Mechanisms or patterns confirmed to work. Prefer these over alternatives.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism"],
            "properties": {
              "mechanism": { "type": "string" },
              "date": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "validation_done": {
      "type": "array",
      "description": "Validation steps already performed upstream. The specialist must not duplicate these but must build on them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target", "result"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["syntax", "typecheck", "startup", "behavior", "manual", "diff"],
            "description": "Coverage level of the validation."
          },
          "target": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "partial", "skipped"]
          },
          "details": { "type": "string" }
        }
      }
    },
    "context_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "prior_decisions", "validation_done"],
      "description": "Explicit declaration of what the invoking agent knows vs. did not check. A value of 'unknown' means the field was not researched — the specialist must not treat it as 'none found'.",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        },
        "prior_decisions": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        },
        "validation_done": {
          "type": "string",
          "enum": ["complete", "partial", "unknown"]
        }
      }
    }
  },
  "examples": [
    {
      "run_id": "evt-loop-fix-20260516",
      "from_agent": "Engineer",
      "to_agent": "code-analyst",
      "deliverable": "Fix event loop blocking in conceptual_art.py with behavior-level validation (docker + /health endpoint).",
      "scope": {
        "files": ["src/graphic_agent/interface/services/conceptual_art.py"],
        "modules": ["GPU pipeline", "asyncio event loop"]
      },
      "stability_gate": {
        "confirmed_stable": true,
        "branch": "agent/evt-loop-fix-2026-05-16"
      },
      "prior_decisions": {
        "reverts": [
          {
            "mechanism": "loop.run_in_executor(None, ...) for CUDA operations",
            "date": "2026-05-11",
            "reason": "Causes CUDA context fragmentation and OOMKill (exit 137).",
            "source": "git revert 1a50b56 + operation log run_id oomkill-diagnosis-001",
            "hard_blocker": true
          }
        ],
        "validated": [
          {
            "mechanism": "Synchronous generation on main asyncio thread",
            "date": "2026-05-11",
            "source": "operation log run_id oomkill-diagnosis-001"
          }
        ]
      },
      "validation_done": [
        {
          "kind": "syntax",
          "target": "conceptual_art.py",
          "result": "passed",
          "details": "py_compile passed after revert."
        }
      ],
      "context_completeness": {
        "scope": "complete",
        "prior_decisions": "complete",
        "validation_done": "partial"
      }
    }
  ]
}
